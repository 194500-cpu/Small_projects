import sys

M, P = map(int, sys.stdin.readline().split())

mat = []
phy = []


mat = [list(map(int, sys.stdin.readline().split())) for person in range(M)]
phy = [list(map(int, sys.stdin.readline().split())) for person in range(P)]

mat.sort()
phy.sort()

m_pointer = 0
p_pointer = 0
overlap = 0

while m_pointer < M and p_pointer < P:
    if mat[m_pointer][0] > phy[p_pointer][1]:
        p_pointer += 1
    elif phy[p_pointer][0] > mat[m_pointer][1]:
        m_pointer += 1
    else:
        if overlap < min(phy[p_pointer][1], mat[m_pointer][1]) - max(phy[p_pointer][0], mat[m_pointer][0]) + 1:
            overlap = min(phy[p_pointer][1], mat[m_pointer][1]) - max(phy[p_pointer][0], mat[m_pointer][0]) + 1
        if mat[m_pointer][1] > phy[p_pointer][1]:
            p_pointer += 1
        elif mat[m_pointer][1] < phy[p_pointer][1]:
            m_pointer +=1
        else:
            m_pointer += 1
            p_pointer += 1

print(overlap)

